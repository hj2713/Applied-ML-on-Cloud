# ============================================
# Environment Variables for HW3 DL Workflow
# ============================================

# --- Training Configuration ---
# Number of training epochs (increase for better accuracy)
EPOCHS=2

# Training batch size
BATCH_SIZE=64

# Directory where the trained model will be saved locally
MODEL_DIR=Deliverables/model_data

# --- Inference Configuration ---
# API Key for authenticating requests to the inference server
API_KEY=dev-secret-key

# Port for the Flask inference server
PORT=50000
